# Local development examples only; replace the password in your local .env.
POSTGRES_DB=flowforge
POSTGRES_USER=flowforge_dev
POSTGRES_PASSWORD=flowforge_dev_example_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Future Celery broker URL for processes running on Windows.
REDIS_URL=redis://127.0.0.1:6379/0
