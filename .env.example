# Local development examples only; replace the password in your local .env.
POSTGRES_DB=flowforge
POSTGRES_USER=flowforge_dev
POSTGRES_PASSWORD=flowforge_dev_example_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Celery broker URL for native Windows processes; Compose overrides the hostname.
REDIS_URL=redis://127.0.0.1:6379/0

# Optional absolute shared path; defaults to the project's uploads directory.
# UPLOAD_DIR=C:/path/to/FlowForge/uploads
# Keep custom upload directories outside Git or add an explicit ignore rule.
